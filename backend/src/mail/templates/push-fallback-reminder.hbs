<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <title>{{title}}</title>
</head>
<body style="margin:0;padding:0;background-color:#f5f7fb;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#f5f7fb" style="width:100%;border-collapse:collapse;">
    <tr>
      <td align="center" style="padding:12px 8px;">
        <!--[if mso]><table role="presentation" width="640" cellpadding="0" cellspacing="0" border="0"><tr><td><![endif]-->
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#ffffff" style="width:100%;max-width:640px;border-collapse:collapse;">
          <tr>
            <td style="padding:20px 20px 12px;font-family:Arial,Helvetica,sans-serif;color:#172033;">
              <h1 style="margin:0;font-size:22px;line-height:29px;">Hallo {{firstName}},</h1>
            </td>
          </tr>
          <tr>
            <td style="padding:0 20px 16px;font-family:Arial,Helvetica,sans-serif;font-size:16px;line-height:25px;color:#172033;">
              <p style="margin:0;">{{intro}}</p>
            </td>
          </tr>
          {{#each items}}
          <tr>
            <td style="padding:0 20px 16px;font-family:Arial,Helvetica,sans-serif;font-size:16px;line-height:25px;color:#172033;">
              <p style="margin:0 0 8px;font-weight:bold;">{{label}}</p>
              {{#if confirmUrl}}
              <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="border-collapse:collapse;">
                <tr>
                  <td bgcolor="#127b46" style="background-color:#127b46;padding:9px 14px;"><a href="{{confirmUrl}}" target="_blank" style="font-family:Arial,Helvetica,sans-serif;font-size:15px;line-height:22px;font-weight:bold;color:#ffffff;text-decoration:none;">Ich komme</a></td>
                  <td width="8" style="width:8px;padding:0;font-size:0;line-height:0;">&nbsp;</td>
                  <td bgcolor="#bb164e" style="background-color:#bb164e;padding:9px 14px;"><a href="{{declineUrl}}" target="_blank" style="font-family:Arial,Helvetica,sans-serif;font-size:15px;line-height:22px;font-weight:bold;color:#ffffff;text-decoration:none;">Ich komme nicht</a></td>
                </tr>
              </table>
              {{/if}}
            </td>
          </tr>
          {{/each}}
          {{#if question}}
          <tr>
            <td style="padding:0 20px 16px;font-family:Arial,Helvetica,sans-serif;font-size:16px;line-height:25px;color:#172033;"><strong>{{question}}</strong></td>
          </tr>
          {{/if}}
          {{#if showGenericLogin}}
          <tr>
            <td style="padding:0 20px 12px;font-family:Arial,Helvetica,sans-serif;font-size:16px;line-height:25px;color:#172033;">Melde dich direkt über deinen Link an:</td>
          </tr>
          <tr>
            <td style="padding:0 20px 12px;">
              <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="border-collapse:collapse;">
                <tr>
                  <td bgcolor="#006fee" style="background-color:#006fee;padding:11px 18px;"><a href="{{magicUrl}}" target="_blank" style="font-family:Arial,Helvetica,sans-serif;font-size:16px;line-height:24px;font-weight:bold;color:#ffffff;text-decoration:none;">Jetzt anmelden</a></td>
                </tr>
              </table>
            </td>
          </tr>
          <tr>
            <td style="padding:0 20px 16px;font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:22px;color:#596579;word-wrap:break-word;">Falls der Button nicht funktioniert: <a href="{{magicUrl}}" target="_blank" style="color:#006fee;word-break:break-all;">{{magicUrl}}</a></td>
          </tr>
          {{/if}}
          <tr>
            <td style="padding:0 20px 20px;font-family:Arial,Helvetica,sans-serif;font-size:16px;line-height:25px;color:#172033;">Vielen Dank für deine Unterstützung und dass du dir kurz Zeit für eine Rückmeldung nimmst.</td>
          </tr>
          {{> footer}}
        </table>
        <!--[if mso]></td></tr></table><![endif]-->
      </td>
    </tr>
  </table>
</body>
</html>
