<!DOCTYPE html>
<html lang="de" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:o="urn:schemas-microsoft-com:office:office">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <title>Dein Anmeldelink</title>
  <!--[if mso]><noscript><xml><o:OfficeDocumentSettings><o:PixelsPerInch>96</o:PixelsPerInch></o:OfficeDocumentSettings></xml></noscript><![endif]-->
</head>
<body style="margin:0;padding:0;background-color:#f5f7fb;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#f5f7fb" style="width:100%;border-collapse:collapse;">
    <tr>
      <td align="center" style="padding:12px 8px;">
        <!--[if mso]><table role="presentation" width="640" cellpadding="0" cellspacing="0" border="0"><tr><td><![endif]-->
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#ffffff" style="width:100%;max-width:640px;border-collapse:collapse;">
          <tr>
            <td style="padding:20px 20px 12px;font-family:Arial,Helvetica,sans-serif;color:#172033;">
              <h1 style="margin:0;font-size:22px;line-height:29px;">Hallo {{firstName}},</h1>
            </td>
          </tr>
          <tr>
            <td style="padding:0 20px 16px;font-family:Arial,Helvetica,sans-serif;font-size:16px;line-height:25px;color:#172033;">
              <p style="margin:0;">Du hast eine Anmeldung für ChorHub angefordert. Du hast zwei Möglichkeiten, dich anzumelden:</p>
            </td>
          </tr>
          <tr>
            <td style="padding:0 20px 12px;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#f5f7fb" style="width:100%;border:1px solid #dde3ee;border-collapse:collapse;">
                <tr>
                  <td style="padding:14px;font-family:Arial,Helvetica,sans-serif;color:#172033;">
                    <p style="margin:0 0 4px;font-size:16px;line-height:23px;font-weight:bold;">Option 1 – Anmeldelink</p>
                    <p style="margin:0 0 14px;font-size:14px;line-height:21px;color:#596579;">Funktioniert im Browser · Dauerhaft gültig</p>
                    <!--[if mso]><v:roundrect xmlns:v="urn:schemas-microsoft-com:vml" xmlns:w="urn:schemas-microsoft-com:office:word" href="{{magicUrl}}" style="height:48px;v-text-anchor:middle;width:190px;" arcsize="10%" fillcolor="#006fee" strokecolor="#006fee"><w:anchorlock/><center style="color:#ffffff;font-family:Arial,sans-serif;font-size:16px;font-weight:bold;">Jetzt anmelden</center></v:roundrect><![endif]-->
                    <!--[if !mso]><!--><a href="{{magicUrl}}" target="_blank" style="display:inline-block;padding:14px 24px;background-color:#006fee;border-radius:6px;font-family:Arial,Helvetica,sans-serif;font-size:16px;line-height:20px;font-weight:bold;color:#ffffff;text-decoration:none;mso-hide:all;">Jetzt anmelden</a><!--<![endif]-->
                  </td>
                </tr>
              </table>
            </td>
          </tr>
          <tr>
            <td style="padding:0 20px 12px;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#f5f7fb" style="width:100%;border:1px solid #dde3ee;border-collapse:collapse;">
                <tr>
                  <td style="padding:14px;font-family:Arial,Helvetica,sans-serif;color:#172033;">
                    <p style="margin:0 0 4px;font-size:16px;line-height:23px;font-weight:bold;">Option 2 – Einmalcode</p>
                    <p style="margin:0 0 12px;font-size:14px;line-height:21px;color:#596579;">Gilt nur 15 Minuten</p>
                    <p style="margin:0 0 12px;font-family:'Courier New',Courier,monospace;font-size:32px;line-height:40px;font-weight:bold;letter-spacing:4px;color:#172033;">{{loginCode}}</p>
                    <p style="margin:0;font-size:14px;line-height:22px;color:#596579;">Öffne die ChorHub-App, gib deine E-Mail-Adresse ein, und trag dann diesen Code ein.</p>
                  </td>
                </tr>
              </table>
            </td>
          </tr>
          <tr>
            <td style="padding:0 20px 20px;font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:22px;color:#596579;">
              <p style="margin:0;">Falls du diese E-Mail nicht angefordert hast, kannst du sie ignorieren.</p>
            </td>
          </tr>
          {{> footer}}
        </table>
        <!--[if mso]></td></tr></table><![endif]-->
      </td>
    </tr>
  </table>
</body>
</html>
