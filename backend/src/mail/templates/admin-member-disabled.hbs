<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <title>ChorHub Mitglied deaktiviert</title>
</head>
<body style="margin:0;padding:0;background-color:#f5f7fb;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#f5f7fb" style="width:100%;border-collapse:collapse;">
    <tr>
      <td align="center" style="padding:12px 8px;">
        <!--[if mso]><table role="presentation" width="640" cellpadding="0" cellspacing="0" border="0"><tr><td><![endif]-->
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#ffffff" style="width:100%;max-width:640px;border-collapse:collapse;">
          <tr>
            <td style="padding:20px 20px 12px;font-family:Arial,Helvetica,sans-serif;color:#172033;">
              <h1 style="margin:0;font-size:22px;line-height:29px;">Mitglied wurde deaktiviert</h1>
            </td>
          </tr>
          <tr>
            <td style="padding:0 20px 20px;font-family:Arial,Helvetica,sans-serif;font-size:16px;line-height:25px;color:#172033;word-wrap:break-word;">
              <p style="margin:0 0 8px;"><strong>Name:</strong> {{firstName}} {{lastName}}</p>
              <p style="margin:0 0 8px;"><strong>E-Mail:</strong> {{memberEmail}}</p>
              <p style="margin:0;"><strong>Grund:</strong> {{reason}}</p>
            </td>
          </tr>
          {{> footer}}
        </table>
        <!--[if mso]></td></tr></table><![endif]-->
      </td>
    </tr>
  </table>
</body>
</html>
