generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum AttendanceResponse {
  CONFIRMED
  DECLINED
}

enum SentEmailStatus {
  PENDING
  SENT
  FAILED
}

model Member {
  id           String     @id @default(uuid())
  firstName    String
  lastName     String
  email        String      @unique
  choirVoiceId String?     @map("choir_voice_id")
  choirVoice   ChoirVoice? @relation(fields: [choirVoiceId], references: [id])
  lastLoginAt  DateTime?
  isDisabled   Boolean     @default(false) @map("is_disabled")
  disabledAt   DateTime?   @map("disabled_at")
  disableReason String?    @map("disable_reason")
  internalComment String?  @map("internal_comment")
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  loginCodes       MemberLoginCode[]
  loginTokens       MemberLoginToken[]
  attendancePlans   AttendancePlan[]
  attendanceRecords AttendanceRecord[]
  pushSubscriptions PushSubscription[]
  personalInfo      PersonalInfoEntry?
  voiceAdminGrants  VoiceAdminGrant[]
  disableNotices    MemberDisableNotice[]

  @@map("members")
}

model MemberDisableNotice {
  id              String   @id @default(uuid())
  memberId        String   @map("member_id")
  member          Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  kind            String
  recipient       String
  memberEmail     String   @map("member_email")
  firstName       String   @map("first_name")
  lastName        String   @map("last_name")
  disableReason   String?  @map("disable_reason")
  attempts        Int      @default(0)
  nextAttemptAt   DateTime @default(now()) @map("next_attempt_at")
  claimedAt       DateTime? @map("claimed_at")
  sentAt          DateTime? @map("sent_at")
  lastError       String?  @map("last_error")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([sentAt, nextAttemptAt])
  @@map("member_disable_notices")
}

model MemberLoginCode {
  id         String   @id @default(uuid())
  memberId   String
  hashedCode String
  expiresAt  DateTime
  member     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([memberId, hashedCode])
  @@index([expiresAt])
  @@map("member_login_codes")
}

model MemberLoginToken {
  id          String   @id @default(uuid())
  memberId    String
  hashedToken String   @unique
  member      Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@map("member_login_tokens")
}

model PushSubscription {
  id        String   @id @default(cuid())
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@map("push_subscriptions")
}

model Rehearsal {
  id          String   @id @default(uuid())
  date        DateTime
  title       String
  description String?
  location    String?
  durationMinutes Int? @map("duration_minutes")
  isOptional  Boolean  @default(false) @map("is_optional")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  attendancePlans   AttendancePlan[]
  attendanceRecords AttendanceRecord[]

  @@map("rehearsals")
}

model AttendancePlan {
  id          String             @id @default(uuid())
  memberId    String
  rehearsalId String
  response    AttendanceResponse
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  member    Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  rehearsal Rehearsal @relation(fields: [rehearsalId], references: [id], onDelete: Cascade)

  @@unique([memberId, rehearsalId])
  @@map("attendance_plans")
}

model AttendanceRecord {
  id          String   @id @default(uuid())
  memberId    String
  rehearsalId String
  createdAt   DateTime @default(now())

  member    Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  rehearsal Rehearsal @relation(fields: [rehearsalId], references: [id], onDelete: Cascade)

  @@unique([memberId, rehearsalId])
  @@map("attendance_records")
}

model AdminUser {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  auditLogs    AdminAuditLog[]

  @@map("admin_users")
}

model AdminAuditLog {
  id          String    @id @default(uuid())
  adminUserId String?   @map("admin_user_id")
  username    String
  action      String
  message     String
  ipAddress   String    @map("ip_address")
  createdAt   DateTime  @default(now()) @map("created_at")
  adminUser   AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([action])
  @@map("admin_audit_logs")
}

model GeneralInfo {
  id              String   @id @default(cuid())
  markdownContent String
  updatedAt       DateTime @updatedAt

  @@map("general_info")
}

model PersonalInfoConfig {
  id               String   @id @default(cuid())
  markdownTemplate String
  emailSubject     String
  updatedAt        DateTime @updatedAt

  @@map("personal_info_config")
}

model PersonalInfoEntry {
  id              String   @id @default(cuid())
  memberId        String   @unique @map("member_id")
  markdownContent String
  updatedAt       DateTime @updatedAt
  member          Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@map("personal_info_entries")
}

model SentEmail {
  id               String             @id @default(uuid())
  subject          String
  markdownContent  String              @map("markdown_content")
  signatureMarkdown String             @default("") @map("signature_markdown")
  status           SentEmailStatus     @default(PENDING)
  sentAt           DateTime?           @map("sent_at")
  createdAt        DateTime            @default(now()) @map("created_at")
  attachments      SentEmailAttachment[]

  @@index([status, sentAt])
  @@map("sent_emails")
}

model SentEmailAttachment {
  id          String   @id @default(uuid())
  sentEmailId String   @map("sent_email_id")
  filename    String
  contentType String   @map("content_type")
  size        Int
  content     Bytes
  sentEmail   SentEmail @relation(fields: [sentEmailId], references: [id], onDelete: Cascade)

  @@index([sentEmailId])
  @@map("sent_email_attachments")
}

model ChoirVoice {
  id        String   @id @default(cuid())
  name      String   @unique
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  members   Member[]
  voiceAdminGrants VoiceAdminGrant[]

  @@map("choir_voices")
}

model VoiceAdminGrant {
  memberId     String
  choirVoiceId String
  member       Member     @relation(fields: [memberId], references: [id], onDelete: Cascade)
  choirVoice   ChoirVoice @relation(fields: [choirVoiceId], references: [id], onDelete: Cascade)

  @@id([memberId, choirVoiceId])
  @@map("voice_admin_grants")
}
